<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F5E6D3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="#FFF8F0"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                app:tint="#3E2723"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Account"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF8F0"
            android:padding="20dp"
            android:elevation="4dp"
            android:gravity="center"
            android:layout_marginBottom="16dp">


            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/cafe_account"
                android:background="#F5E6D3"
                android:padding="16dp"
                android:contentDescription="Profile Picture"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/txtProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faena Flores"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="faena.rf@gmail.com"
                android:textSize="13sp"
                android:textColor="#8D6E63"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnEditProfile"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="180dp"
                android:layout_height="40dp"
                android:text="Edit Profile"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#4E342E"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF8F0"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Details"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#3E2723"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textSize="12sp"
                android:textColor="#8D6E63"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Faena Ciaron R. Flores"
                android:textSize="14sp"
                android:textColor="#3E2723"
                android:background="#F5E6D3"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="12sp"
                android:textColor="#8D6E63"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="faena.rf@gmail.com"
                android:textSize="14sp"
                android:textColor="#3E2723"
                android:background="#F5E6D3"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textSize="12sp"
                android:textColor="#8D6E63"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="+63 975 698 6404"
                android:textSize="14sp"
                android:textColor="#3E2723"
                android:background="#F5E6D3"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF8F0"
            android:padding="8dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnOrderHistory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Order History"
                android:textSize="14sp"
                android:textColor="#3E2723"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:layout_marginBottom="2dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D7CCC8"/>

            <TextView
                android:id="@+id/btnRewards"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="My Rewards"
                android:textSize="14sp"
                android:textColor="#3E2723"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:layout_marginBottom="2dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D7CCC8"/>

            <TextView
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Change Password"
                android:textSize="14sp"
                android:textColor="#3E2723"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Log Out"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#8D6E63"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>

</ScrollView>
